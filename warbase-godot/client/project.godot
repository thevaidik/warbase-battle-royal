[network]

ws/max_in_buffer_kb=64
ws/max_out_buffer_kb=64

[audio]

general/output_latency=10
general/output_latency.web=20

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
scaling_3d/mode=0
scaling_3d/scale=1.0
scaling_3d/fsr_sharpness=0.0
scaling_3d/mode.web=0
scaling_3d/scale.web=1.0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=8
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/ssao/half_size=true
environment/screen_space_reflection/roughness_quality=1
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.08, 1)
