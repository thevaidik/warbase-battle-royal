FROM node:22-alpine AS build
WORKDIR /src
COPY warbase-colyseus/package*.json ./warbase-colyseus/
WORKDIR /src/warbase-colyseus
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY warbase-colyseus/tsconfig.json ./
COPY warbase-colyseus/scripts ./scripts
COPY warbase-colyseus/src ./src
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production PORT=8081 HOST=0.0.0.0 STATIC_DIR=/app/static
WORKDIR /app
COPY warbase-colyseus/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=build /src/warbase-colyseus/dist ./dist
COPY --from=build /src/warbase-colyseus/src/data ./dist/data
COPY warbase-godot/client/candidate-static/ ./static/
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8081/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
USER node
CMD ["node", "dist/index.js"]
