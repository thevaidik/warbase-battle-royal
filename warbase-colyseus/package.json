{
  "name": "warbase-colyseus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "dev": "HOST=127.0.0.1 ENABLE_LOCAL_MONITOR=1 tsx watch src/index.ts",
    "test": "npm run check && node --import tsx --test src/*.test.ts",
    "test:state-view": "node --import tsx --test repro/state-view/node.test.ts",
    "state-view:server": "node --import tsx repro/state-view/server.ts",
    "benchmark:geometry": "GEOMETRY_BENCHMARK=1 node --import tsx --test src/world-geometry.test.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/admin": "0.18.6",
    "@colyseus/auth": "0.18.4",
    "@colyseus/core": "0.18.10",
    "@colyseus/database": "0.18.5",
    "@colyseus/monitor": "0.18.7",
    "@colyseus/playground": "0.18.6",
    "@colyseus/redis-driver": "0.18.7",
    "@colyseus/redis-presence": "0.18.6",
    "@colyseus/schema": "5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "colyseus": "0.18.10",
    "drizzle-orm": "1.0.0-rc.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.8",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
